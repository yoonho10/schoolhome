  <button class="to-top" id="toTop" aria-label="맨 위로 이동">↑</button>

  <script>
    // Header shadow on scroll
    const header = document.getElementById('header');
    const toTop = document.getElementById('toTop');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
      toTop.classList.toggle('show', window.scrollY > 500);
    });
    toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    // Mobile menu
    const hamburger = document.getElementById('hamburger');
    const nav = document.getElementById('nav');
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('open');
      nav.classList.toggle('open');
    });
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      hamburger.classList.remove('open');
      nav.classList.remove('open');
    }));

    // Accordion
    document.querySelectorAll('.rule-item .rule-q, .faq-item .faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const body = btn.nextElementSibling;
        const isOpen = item.classList.contains('open');
        // close siblings in same list
        item.parentElement.querySelectorAll(':scope > .open').forEach(other => {
          other.classList.remove('open');
          other.querySelector('.rule-a, .faq-a').style.maxHeight = null;
        });
        if (!isOpen) {
          item.classList.add('open');
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    });

    // Tabs
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    function activateTab(name) {
      tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === name));
      panels.forEach(p => p.classList.toggle('active', p.id === 'tab-' + name));
    }
    tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn.dataset.tab)));

    // Category cards -> jump to specific tab
    document.querySelectorAll('[data-goto-tab]').forEach(card => {
      card.addEventListener('click', () => activateTab(card.dataset.gotoTab));
    });

    // Reveal on scroll
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
